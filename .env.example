# ALIBI configuration — copy to .env and edit.
# Every default below is exactly the value alibi/config.py uses when the variable is absent, so an EMPTY
# .env is a valid, working, fully-offline configuration. Names are not decorative: `ALIBI_DB` and
# `DATABASE_URL` both set the ledger path, `OLLAMA_BASE_URL` (not OLLAMA_URL) sets the local server.

# ---- where the ledger lives -----------------------------------------------------------------
ALIBI_DB=/data/alibi.db
# DATABASE_URL=sqlite:///data/alibi.db      # wins over ALIBI_DB if both are set
ALIBI_UPLOAD_DIR=/data/uploads
ALIBI_MAX_DOC_BYTES=12582912                 # 12 MiB; a bigger upload is rejected, not truncated

# ---- extraction routing ---------------------------------------------------------------------
# auto   = use the best provider this machine can actually reach, and report which one it got
# demo   = rules + deterministic simulator, no model, no network (says so on every page)
# local  = local model only; cloud refused entirely
# hybrid = rules -> local -> one verified cloud escalation per source, budget-capped
ALIBI_MODE=demo
MODEL_PROVIDER=                              # auto|ollama|openai|gemini|rules ("" -> detect)
LOCAL_MODEL_NAME=gemma4:e4b
OLLAMA_BASE_URL=http://127.0.0.1:11434       # if empty, the adapter falls back to OLLAMA_HOST, then 127.0.0.1:11434
ALIBI_MAX_OUTPUT_TOKENS=2048                 # model output is untrusted AND bounded

# ---- cloud escalation -----------------------------------------------------------------------
# Only live if a key exists AND CLOUD_ESCALATION_ENABLED is on. Setting a key is a decision that a
# third party may read your academic documents; the defaults keep that decision closed.
# GEMINI_API_KEY=                            # or GOOGLE_GEMINI_API_KEY
# OPENAI_API_KEY=                            # any OpenAI-compatible server, incl. Groq/Cerebras
# OPENAI_BASE_URL=
# OPENAI_MODEL=
ALIBI_GEMINI_MODEL=gemini-2.5-flash-lite
CLOUD_ESCALATION_ENABLED=false               # default True in code; set false to make refusal structural
MAX_CLOUD_EGRESS=4000000                     # bytes/day leaving the machine
ALIBI_MAX_CLOUD_CALLS=4                      # per artifact (a 12-page notice gets 4 tries, not 40)
ALIBI_DAY_LIMIT_USD=0.50
REQUIRE_ACTION_APPROVAL=true
DRY_RUN=true                                 # no real external writes unless you turn this off
ALIBI_ALLOW_IRREVERSIBLE=false               # 'submit assignment' / 'drop course' never auto-execute,
                                              # and that is true even when this is set to true

# ---- trust and institution policy -----------------------------------------------------------
ALIBI_CONFIDENCE_FLOOR=0.72                  # below this a proposal is never trusted without verification
ALIBI_SUPERSEDE_TRUST_FLOOR=0.5              # a source must reach this trust to retire a stronger one
ALIBI_ATTENDANCE_THRESHOLD=0.75              # AICTE/UGC per-subject including lab
ALIBI_CONDONATION_FLOOR=0.65                 # medical condonation floor; certificate before freeze date
ALIBI_INSTITUTION_CONFIG=                    # path to a policy JSON/YAML; "" -> built-in tn-default

# ---- privacy --------------------------------------------------------------------------------
RETENTION_DAYS=365                           # how long claims and receipts live
ALIBI_RAW_RETENTION_DAYS=30                  # how long raw source TEXT lives after verification
ALIBI_REDACTIONS=                            # extra literal strings masked in every egress payload
ALIBI_NEVER_LIST=send_email,submit_assignment,delete_submission,drop_course,pay_fee

# ---- interface and logs ---------------------------------------------------------------------
PORT=8000
LOG_LEVEL=INFO
ALIBI_LOG_JSON=true                          # false for one-line human logs while debugging
DEBUG=false                                  # adds tracebacks to 500s; never set in a shared demo
# ---- extra knobs the code reads (all optional) -------------------------------------------------
# `ALIBI_TODAY` freezes "today" for the planner, risk decay and the retention window. Reproducible
# regression runs and demos want it; a normal install must not set it, or the horizon stops moving.
# ALIBI_TODAY=2026-09-13
# Which env var holds the LM Studio key. Default LM_STUDIO_API_KEY (above); change the *name*, never the
# value, so a proxy token can live wherever your secret manager already puts it.
# LM_STUDIO_API_KEY_ENV=LM_STUDIO_PROXY_TOKEN
# A third spelling of the loopback OpenAI-compat URL, if you prefer it to LM_STUDIO_BASE_URL.
# LOCAL_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# Ollama's own native variable name, used only when OLLAMA_BASE_URL is empty (then 127.0.0.1:11434).
# OLLAMA_HOST=127.0.0.1:11434
ALIBI_STUDENT=                               # shown in draft letters; also the first redaction target
ALIBI_FACULTY_EMAIL=                         # recipient shown on the draft preview (nothing is sent)
