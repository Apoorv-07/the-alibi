# runtime state — the ledger is the product, so a copied database would fake a demo
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/
uploads/

# local secrets: .env.example is committed, .env is not
.env

# python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
build/
dist/
*.egg-info/

# the browser harness's own install: 19 MB of vendored Playwright, re-created by `make browser`
.tools/node_modules/
.tools/package-lock.json
.tools/*.png
.tools/verify-*.txt
